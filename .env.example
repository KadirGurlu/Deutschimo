# PostgreSQL connection string. Vercel Marketplace can inject this automatically.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/deutschimo?sslmode=require"

# Auth.js
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Security hashing and scheduled maintenance
SECURITY_HASH_KEY="use-a-second-long-random-secret"
CRON_SECRET="use-a-third-long-random-secret"

# Optional private Vercel Blob backups. Create a Private Blob store and connect it to the project.
# Vercel üzerinde Blob bağlantısı OIDC ile BLOB_STORE_ID oluşturur.
# Yerel veya Vercel dışı çalışma için isteğe bağlı geri dönüş:
BLOB_READ_WRITE_TOKEN=""
# Exactly 32 random bytes encoded as Base64. Backups are AES-256-GCM encrypted before upload.
BACKUP_ENCRYPTION_KEY=""
BACKUP_RETENTION_DAYS="14"

# Optional Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"

# Optional transactional e-mail via Resend
RESEND_API_KEY=""
EMAIL_FROM="Deutschimo <noreply@example.com>"
REQUIRE_EMAIL_VERIFICATION="false"

# Existing projects should leave this false. Enable once only on a brand-new empty database.
BOOTSTRAP_ADMIN_ON_BUILD="false"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"
ADMIN_FIRST_NAME="Deutschimo"
ADMIN_LAST_NAME="Yönetici"
