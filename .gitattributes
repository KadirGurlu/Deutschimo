# Deutschimo repository-level line ending policy.
# Source/config files stay LF in Git; Windows launchers stay CRLF.
* text=auto

*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.prisma text eol=lf
*.sql text eol=lf
*.css text eol=lf
*.html text eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.zip binary
