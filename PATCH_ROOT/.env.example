# V28.1 DATABASE ISOLATION — PRISMA POSTGRES / VERCEL
# Vercel Prisma Postgres entegrasyonu bu üç değeri otomatik üretir.
# DATABASE_URL: uygulama sorguları için Prisma bağlantısı.
# DATABASE_POSTGRES_URL: migration ve güvenlik kontrolleri için doğrudan PostgreSQL bağlantısı.
# DATABASE_PRISMA_DATABASE_URL: entegrasyon tarafından sağlanan ek Prisma bağlantısı; kod doğrudan kullanmaz.
DATABASE_URL="prisma+postgres://PRISMA_DATABASE_URL"
DATABASE_POSTGRES_URL="postgresql://USER:PASSWORD@POSTGRES_HOST:5432/postgres?sslmode=require"
DATABASE_PRISMA_DATABASE_URL="prisma+postgres://PRISMA_DATABASE_URL"
# production | preview | development | test
DATABASE_ENVIRONMENT="development"

# İsteğe bağlı ikinci güvenlik katmanı. Production bağlantısıyla `npm run db:fingerprint`
# çalıştırıp çıktıyı Preview/Development/Test ortamlarına ekleyebilirsiniz.
PRODUCTION_DATABASE_FINGERPRINT=""
# Boş production dışı DB'lerde baseline'ı otomatik kurar. Preview/Test için güvenlidir.
AUTO_INIT_NON_PRODUCTION_DATABASE="false"
# Preview build sonrasında deterministik test hesaplarını yeniler.
SEED_PREVIEW_TEST_DATA="false"
TEST_USER_PASSWORD=""
# V28.1 ilk production deployment'ında yalnızca bir kez kullanılır; Ready sonrası silinir.
CONFIRM_PRODUCTION_BASELINE=""
# Yalnızca migration geçmişi olmayan mevcut development/preview şemasını bilinçli benimsemek için.
CONFIRM_NON_PRODUCTION_BASELINE=""
# Eski db push komutu sadece geçici development prototiplemesi için açık onay ister.
ALLOW_PRISMA_DB_PUSH=""

# Auth.js
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Security hashing and scheduled maintenance
SECURITY_HASH_KEY="use-a-second-long-random-secret"
CRON_SECRET="use-a-third-long-random-secret"
# Optional separate secret for /api/v1/health?deep=1. If empty, CRON_SECRET is used.
HEALTH_CHECK_SECRET=""
# Optional private Vercel Blob backups. Create a Private Blob store and connect it to the project.
BLOB_READ_WRITE_TOKEN=""
# Exactly 32 random bytes encoded as Base64. Backups are AES-256-GCM encrypted before upload.
BACKUP_ENCRYPTION_KEY=""
BACKUP_RETENTION_DAYS="14"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"
# Optional transactional e-mail via Resend
RESEND_API_KEY=""
EMAIL_FROM="Deutschimo <noreply@example.com>"
REQUIRE_EMAIL_VERIFICATION="false"
# Existing projects should leave this false. Enable once only on a brand-new empty database.
BOOTSTRAP_ADMIN_ON_BUILD="false"
# Preview/test admin bootstrap ayrıca açıkça izin ister.
ALLOW_PREVIEW_ADMIN_BOOTSTRAP="false"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"
ADMIN_FIRST_NAME="Deutschimo"
ADMIN_LAST_NAME="Yönetici"

# V29 AI writing / V30 Real Germany evaluation
OPENAI_API_KEY=""
OPENAI_WRITING_MODEL="gpt-5.4-mini"
OPENAI_REAL_GERMANY_MODEL="gpt-5.4-mini"

# V31 client compatibility. Mobile apps are not released yet; defaults are safe when empty.
MIN_WEB_APP_VERSION="31.0.0"
MIN_IOS_APP_VERSION="0.0.0"
MIN_ANDROID_APP_VERSION="0.0.0"

NEXT_TELEMETRY_DISABLED="1"
