{
  "name": "deutschimo-platform",
  "version": "28.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/validate-environment.mjs && node scripts/validate-v27.mjs && node scripts/validate-v28.mjs && node scripts/validate-v28-1.mjs && node scripts/validate-v28-3.mjs && node scripts/validate-v28-4.mjs",
    "build": "prisma generate && next build",
