{
  "name": "deutschimo-platform",
  "version": "27.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/validate-environment.mjs && node scripts/validate-v27.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "preflight": "npm run validate:env && npm run validate:v27 && npm run typecheck",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:safe-sync": "prisma db push --skip-generate",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:bootstrap-admin": "node prisma/seed.mjs",
    "validate:env": "node scripts/validate-environment.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:v8": "node scripts/validate-v8.mjs",
    "validate:v9": "node scripts/validate-v9.mjs",
    "validate:v10": "node scripts/validate-v10.mjs",
    "validate:v11": "node scripts/validate-v11.mjs",
    "validate:v12": "node scripts/validate-v12.mjs",
    "validate:v12.1": "node scripts/validate-v12-1.mjs",
    "validate:v13": "node scripts/validate-v13.mjs",
    "validate:v14": "node scripts/validate-v14.mjs",
    "validate:v16": "node scripts/validate-v16.mjs",
    "validate:v16:types": "tsc -p tsconfig.v16-check.json",
    "validate:v17": "node scripts/validate-v17.mjs",
    "validate:v19": "node scripts/validate-v19.mjs",
    "validate:v20": "node scripts/validate-v20.mjs",
    "validate:v21": "node scripts/validate-v21.mjs",
    "validate:v22": "node scripts/validate-v22.mjs",
    "validate:v23": "node scripts/validate-v23.mjs",
    "validate:v24": "node scripts/validate-v24.mjs",
    "validate:v25": "node scripts/validate-v25.mjs",
    "validate:v26": "node scripts/validate-v26.mjs",
    "validate:v27": "node scripts/validate-v27.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.8.0",
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.2",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "next-auth": "5.0.0-beta.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "@vercel/blob": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "prisma": "^6.7.0",
    "typescript": "^5.7.2",
    "dotenv": "^16.4.7"
  },
  "overrides": {
    "@auth/core": "0.38.0"
  },
  "engines": {
    "node": ">=20.10 <23"
  }
}
