    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preflight": "npm run quality:check",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "node scripts/db-push-guard.mjs",
    "db:safe-sync": "node scripts/db-push-guard.mjs --skip-generate",
    "db:deploy": "node scripts/db-deploy.mjs",
    "db:baseline:init": "node scripts/db-baseline-init.mjs",
    "db:fingerprint": "node scripts/db-fingerprint.mjs",
    "db:migrate:create": "node scripts/db-migration.mjs create",
    "db:migrate:dev": "node scripts/db-migration.mjs apply",
    "db:migrate:status": "node scripts/db-migration.mjs status",
    "db:drift:check": "node scripts/db-drift-check.mjs",
    "db:test:seed": "node scripts/db-test-data.mjs seed",
    "db:test:reset": "node scripts/db-test-data.mjs reset",
    "db:test:clean": "node scripts/db-test-data.mjs clean",
    "db:test:assert": "node scripts/db-test-data.mjs assert",
    "db:test:assert-clean": "node scripts/db-test-data.mjs assert-clean",
    "db:test:list": "node scripts/db-test-data.mjs list",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:bootstrap-admin": "node prisma/seed.mjs",
    "validate:env": "node scripts/validate-environment.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:v8": "node scripts/validate-v8.mjs",
    "validate:v9": "node scripts/validate-v9.mjs",
    "validate:v10": "node scripts/validate-v10.mjs",
    "validate:v11": "node scripts/validate-v11.mjs",
    "validate:v12": "node scripts/validate-v12.mjs",
    "validate:v12.1": "node scripts/validate-v12-1.mjs",
    "validate:v13": "node scripts/validate-v13.mjs",
    "validate:v14": "node scripts/validate-v14.mjs",
    "validate:v16": "node scripts/validate-v16.mjs",
    "validate:v16:types": "tsc -p tsconfig.v16-check.json",
    "validate:v17": "node scripts/validate-v17.mjs",
    "validate:v19": "node scripts/validate-v19.mjs",
    "validate:v20": "node scripts/validate-v20.mjs",
    "validate:v21": "node scripts/validate-v21.mjs",
    "validate:v22": "node scripts/validate-v22.mjs",
    "validate:v23": "node scripts/validate-v23.mjs",
    "validate:v24": "node scripts/validate-v24.mjs",
    "validate:v25": "node scripts/validate-v25.mjs",
    "validate:v26": "node scripts/validate-v26.mjs",
    "validate:v27": "node scripts/validate-v27.mjs",
    "validate:v28": "node scripts/validate-v28.mjs",
    "validate:v28.1": "node scripts/validate-v28-1.mjs",
    "quality:check": "npm run lint && npm run typecheck && npm run validate:content && npm run validate:v27 && npm run validate:v28 && npm run validate:v28.1 && npm run validate:v28.3 && npm run validate:v28.4",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "validate:v28.3": "node scripts/validate-v28-3.mjs",
    "validate:v28.4": "node scripts/validate-v28-4.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.8.0",
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.2",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "next-auth": "5.0.0-beta.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "@vercel/blob": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "prisma": "^6.7.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@auth/core": "0.38.0"
  },
  "engines": {
    "node": ">=20.10 <23"
  }
}
