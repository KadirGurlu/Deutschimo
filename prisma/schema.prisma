generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  EDITOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Level {
  A1
  A2
  B1
  B2
}

enum ExerciseType {
  MULTIPLE_CHOICE
  FILL
  TRANSLATION
  ORDER
}

model User {
  id           String         @id @default(cuid())
  firstName    String
  lastName     String
  email        String         @unique
  passwordHash String?
  role         UserRole       @default(STUDENT)
  status       UserStatus     @default(ACTIVE)
  currentLevel Level          @default(A1)
  targetLevel  Level          @default(B2)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  progress     UnitProgress[]
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  level       Level
  title       String
  description String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  units       Unit[]
}

model Unit {
  id          String      @id @default(cuid())
  courseId    String
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug        String
  order       Int
  title       String
  subtitle    String
  duration    String
  intro       String      @db.Text
  grammar     String      @db.Text
  grammarNote String      @db.Text
  objectives  Json
  vocabulary  Json
  examples    Json
  summary     Json
  isPublished Boolean     @default(false)
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  exercises   Exercise[]
  progress    UnitProgress[]

  @@unique([courseId, slug])
  @@index([courseId, order])
}

model Exercise {
  id          String       @id @default(cuid())
  unitId      String
  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  order       Int
  type        ExerciseType
  prompt      String       @db.Text
  options     Json?
  answer      String
  explanation String       @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([unitId, order])
}

model UnitProgress {
  id          String   @id @default(cuid())
  userId      String
  unitId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())
  score       Int?

  @@unique([userId, unitId])
  @@index([userId, completedAt])
}
