generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  EDITOR
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum Level {
  A1
  A2
  B1
  B2
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum ExerciseType {
  MULTIPLE_CHOICE
  MULTIPLE_SELECT
  TRUE_FALSE
  FILL_IN_THE_BLANK
  MATCHING
  SENTENCE_ORDERING
  TRANSLATION
  DIALOGUE_COMPLETION
  SHORT_ANSWER
  WRITING_ASSIGNMENT
}

model User {
  id                  String                    @id @default(cuid())
  name                String?
  firstName           String?
  lastName            String?
  email               String?                   @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?
  role                UserRole                  @default(STUDENT)
  status              UserStatus                @default(ACTIVE)
  currentLevel        Level                     @default(A1)
  targetLevel         Level                     @default(B2)
  dailyGoalMinutes    Int                       @default(30)
  onboardingCompleted Boolean                   @default(false)
  isTestUser          Boolean                   @default(false)
  privacyAcceptedAt   DateTime?
  cookieConsentAt     DateTime?
  accountDeletionRequestedAt DateTime?
  lastSeenAt          DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  accounts            Account[]
  sessions            Session[]
  enrollments         Enrollment[]
  learningSnapshot    LearningStateSnapshot?
  unitProgress        UserUnitProgress[]
  activityEvents      UserActivityEvent[]
  studySessions       StudySession[]
  emailTokens         EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  placementAttempts    PlacementAssessment[]
  intelligenceSnapshot LearningInsightSnapshot?
  dailyStudyPlans       DailyStudyPlan[]
  smartReviewState      SmartReviewState?

  @@index([role, status])
  @@index([createdAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Course {
  id             String        @id
  slug           String        @unique
  level          Level
  title          String
  description    String
  status         ContentStatus @default(PUBLISHED)
  estimatedHours Int           @default(0)
  unitCount      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  units          Unit[]
  enrollments    Enrollment[]
}

model Unit {
  id                  String        @id
  courseId            String
  course              Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug                String
  order               Int
  title               String
  description         String
  estimatedMinutes    Int           @default(0)
  status              ContentStatus @default(PUBLISHED)
  prerequisiteUnitId  String?
  progressWeights     Json
  completionRules     Json
  contentPayload      Json?
  deletedAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  exercises           Exercise[]

  @@unique([courseId, slug])
  @@index([courseId, order])
}

model Exercise {
  id              String       @id
  unitId          String
  unit            Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  groupId         String?
  order           Int
  type            ExerciseType
  title           String
  prompt          String       @db.Text
  options         Json?
  correctAnswer   Json
  acceptedAnswers Json?
  explanation     String       @db.Text
  relatedSlideId  String?
  isRequired      Boolean      @default(true)
  maxAttempts     Int          @default(2)
  points          Int          @default(10)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([unitId, order])
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, status])
}

model LearningStateSnapshot {
  id        String   @id @default(cuid())
  userId    String   @unique
  state     Json
  version   Int      @default(12)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserUnitProgress {
  id                        String   @id @default(cuid())
  userId                    String
  courseId                  String
  unitId                    String
  status                    String
  stage                     String
  lessonProgress            Int      @default(0)
  exerciseProgress          Int      @default(0)
  quizProgress              Int      @default(0)
  totalProgress             Int      @default(0)
  bestQuizScore             Int?
  completedSlideIds         Json
  completedExerciseIds      Json
  startedAt                 DateTime?
  completedAt               DateTime?
  lastVisitedAt             DateTime?
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@index([userId, courseId])
  @@index([courseId, status])
}

model UserActivityEvent {
  id        String   @id
  userId    String
  eventType String
  courseId  String
  unitId    String?
  itemId    String?
  metadata  Json?
  createdAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model StudySession {
  id            String   @id
  userId        String
  courseId      String
  unitId        String?
  startedAt     DateTime
  endedAt       DateTime?
  activeSeconds Int      @default(0)
  sessionType   String
  deviceType    String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}


model PlacementAssessment {
  id               String   @id @default(cuid())
  userId           String
  answers          Json
  levelScores      Json
  strengths        Json
  weakTopics       Json
  recommendedLevel Level
  totalScore       Int
  correctCount     Int
  questionCount    Int
  completedAt      DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
}

model LearningInsightSnapshot {
  id            String   @id @default(cuid())
  userId        String   @unique
  weakTopics    Json
  strengths     Json
  hasEnoughData Boolean  @default(false)
  sourceVersion Int      @default(12)
  generatedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyStudyPlan {
  id               String   @id @default(cuid())
  userId           String
  planDate         String
  goalMinutes      Int
  plannedMinutes   Int
  completedMinutes Int      @default(0)
  tasks            Json
  generatedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planDate])
  @@index([userId, planDate])
}

model SmartReviewState {
  id           String   @id @default(cuid())
  userId       String   @unique
  queue        Json
  completedIds Json
  attempts     Json
  generatedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorEmail  String?
  action      String
  entityType  String
  entityId    String?
  summary     String
  before      Json?
  after       Json?
  metadata    Json?
  ipHash      String?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}

model SystemErrorLog {
  id          String   @id @default(cuid())
  source      String
  route       String?
  method      String?
  message     String   @db.Text
  stack       String?  @db.Text
  digest      String?
  fingerprint String?
  requestId   String?
  ipHash      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([fingerprint, createdAt])
}

model ApiFailureLog {
  id         String   @id @default(cuid())
  route      String
  method     String
  statusCode Int
  requestId  String?
  ipHash     String?
  userAgent  String?
  message    String?
  createdAt  DateTime @default(now())

  @@index([route, createdAt])
  @@index([statusCode, createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  emailHash String
  ipHash    String
  success   Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now())

  @@index([emailHash, createdAt])
  @@index([ipHash, createdAt])
}

model RateLimitEvent {
  id        String   @id @default(cuid())
  scope     String
  keyHash   String
  createdAt DateTime @default(now())

  @@index([scope, keyHash, createdAt])
}

model DatabaseBackup {
  id              String   @id @default(cuid())
  status          String
  storageProvider String?
  pathname        String?
  downloadUrl     String?
  checksum        String?
  byteSize        Int?
  tableCounts     Json?
  errorMessage    String?  @db.Text
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([startedAt])
  @@index([status, startedAt])
}

model AccountDeletionLog {
  id            String   @id @default(cuid())
  userIdHash    String
  emailHash     String?
  deletionType  String
  requestedAt   DateTime @default(now())
  completedAt   DateTime?
  metadata      Json?

  @@index([requestedAt])
}
